{
  "expo": {
    "name": "NUZ",
    "slug": "nuz-student-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/logo.png",
    "scheme": "National University Of Zoland",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.petertung.nuzstudentapp"
    },
    "predictiveBackGestureEnabled": false,
    "package": "com.petertung.nuz",
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "4ab34f44-3e3a-4e6e-880a-531e7a0c04ed"
      }
    }
  },
  "web": {
    "bundler": "metro",
    "output": "static",
    "favicon": "./assets/images/favicon.jpg"
  },
  "plugins": [
    "expo-router",
    [
      "expo-splash-screen",
      {
        "backgroundColor": "#208AEF",
        "image": "./assets/images/favicon.jpg",
        "imageWidth": 76
      }
    ],
    "expo-video",
    "expo-sqlite",
    "expo-image",
    "expo-web-browser"
  ],
  "experiments": {
    "typedRoutes": true,
    "reactCompiler": true
  },
  "extra": {
    "router": {},
    "eas": {
      "projectId": "7e949643-4ec3-4252-9ecb-cbd7fbc6fd9b"
    }
  },
  "owner": "petertung"
}
