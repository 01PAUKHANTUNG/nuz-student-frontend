{
  "expo": {
    "name": "NUZ",
    "slug": "nuz-student-app",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "nuz",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.petertung.nuzstudentapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.petertung.nuzstudentapp",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-sqlite",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ab34f44-3e3a-4e6e-880a-531e7a0c04ed"
      }
    },
    "owner": "petertung"
  }
}